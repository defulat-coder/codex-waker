{
  "name": "@waker/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "portless": {
    "name": "waker",
    "script": "dev:app",
    "appPort": 5210
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --experimental-test-module-mocks --test --import ./src/test-setup.ts src/*.test.ts src/*.test.tsx src/**/*.test.ts src/**/*.test.tsx",
    "lint": "tsc -p tsconfig.json --noEmit && eslint --config ../../eslint.config.js src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@waker/contracts": "workspace:*",
    "mermaid": "^11.17.2",
    "motion": "13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@waker/eslint": "workspace:*",
    "eslint": "^10.9.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "vite": "^8.2.2"
  }
}
