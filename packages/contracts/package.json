{
  "name": "@waker/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit && eslint --config ../../eslint.config.js src",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@waker/eslint": "workspace:*",
    "eslint": "^10.9.0"
  }
}
