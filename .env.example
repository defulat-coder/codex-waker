# Agents require a real Codex thread; set to true to enable chat turns.
CODEX_AGENT_ENABLED=true

# 默认使用 Codex CLI 已登录的 OpenAI 账号；也可以在 API 进程中提供 key。
# CODEX_API_KEY=

# 可选自定义 provider 的 key。provider 元数据放在 .codex/settings.json，密钥只放环境变量。
# KIMI_API_KEY=

# Default model for new threads (defaults to settings.json defaultModel).
# CODEX_MODEL=gpt-5.6-sol

# Override the provider id from settings.json modelProvider.
# CODEX_MODEL_PROVIDER=

# Reasoning effort for new threads (minimal/low/medium/high/xhigh/max/ultra), default medium.
# CODEX_REASONING_EFFORT=medium

# Codex sandbox / approval model for workbench threads (chat-safe defaults).
# CODEX_SANDBOX_MODE=read-only
# CODEX_APPROVAL_POLICY=never

# API 监听端口，默认 4410（portless 代理模式下一般无需修改）。
# PORT=4410

# API 监听地址，默认 127.0.0.1。
# HOST=127.0.0.1

# 允许跨域的 Web 来源，默认 https://waker.localhost。
# WEB_ORIGIN=https://waker.localhost

# Web 开发服务器直连 API 的地址。
# WAKER_API_ORIGIN=http://127.0.0.1:4410

# API 日志级别（trace/debug/info/warn/error），默认 info。
# LOG_LEVEL=info
